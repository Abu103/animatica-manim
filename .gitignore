.venv/
__pycache__/
*.egg-info/
out*/
media/
.animatica_cache/
*.mp4


# local TinyTeX runtime from bootstrap
.tex/


# --- HyperFrames experiment pilots ---
# Project-local npm dependencies, browser binaries and caches are never committed.
node_modules/
.hyperframes/
.hf-cache/
*.log

# Generated render outputs, extracted frames and seek snapshots.
# (Source compositions under renders/ are tracked; only media is ignored.)
*.mp4
*.webm
*.mov
*.gif
renders*/frames*/
frames*/
snapshots*/
*.hf-segments/

# Third-party asset trees are regenerated by scripts/setup_assets.py from the
# pinned npm dependencies (gsap, @fontsource/*), so no third-party binary is
# committed to this repository:
#   * GSAP ships under Webflow's Standard "no charge" license, not an OSS
#     license, so the vendored runtime is built locally rather than published.
#   * The SIL OFL fonts are published as npm packages and copied locally.
# Only the license/attribution files (vendor/GSAP-LICENSE.txt,
# assets/LICENSE-*.txt) are tracked.
experiments/hyperframes-3sat-pilot/vendor/gsap.min.js
experiments/hyperframes-3sat-pilot/assets/*.woff2
experiments/hyperframes-3sat-pilot/assets/*.wav
experiments/hyperframes-binary-search-pilot/vendor/gsap.min.js
experiments/hyperframes-binary-search-pilot/assets/*.woff2
experiments/hyperframes-binary-search-pilot/assets/*.wav

# Windows helper script for the 3-SAT pilot.
experiments/hyperframes-3sat-pilot/run-windows.ps1

# bootstrap-installed native bundle (wheels + shared libs)
native/
