            "y_range": [
              -1.5,
              1.5
            ],
            "label": "sin(x)",
            "approx_label": "Taylor polynomial near 0"
          },
          "caption": "The polynomial tracks sine closely near zero and diverges farther away."
        },
        {
          "component": "steps_list",
          "params": {
            "items": [
              "Choose a center point a.",
              "Match the function's value and derivatives at a.",
              "Add more terms to improve the approximation near a."
            ]
          },
          "caption": "Each term uses a higher derivative to fit the curve better close to the center."
